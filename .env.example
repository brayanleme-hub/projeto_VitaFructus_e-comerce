# Copie este arquivo para ".env" e preencha.
# O .env NUNCA vai para o GitHub (está no .gitignore).

PORT=3000
NODE_ENV=development

# Gere um valor com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=f546c12ce4b094a62d186f8d0b2c768b6e567bffd5bf1b747fa336e25f3c84da

# (Opcional) Cria o administrador automaticamente na primeira vez que o servidor liga,
# se ainda não existir nenhum admin. Use uma senha sua, com 8+ caracteres.
# Alternativa: deixe em branco e rode "npm run criar-admin".
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=

# (Opcional) Endereço real da loja para a página "Onde estamos".
# Sem isso, o mapa usa um ponto demonstrativo em Heliópolis.
# Para descobrir latitude/longitude: no Google Maps, clique com o botão direito no local.
LOJA_NOME=
LOJA_ENDERECO=
LOJA_LATITUDE=
LOJA_LONGITUDE=
LOJA_RAIO_ENTREGA_KM=5
LOJA_TELEFONE=
